generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contacto {
  id         Int      @id @default(autoincrement())
  nome       String
  telefone   String
  email      String   @unique
  foto       String?
  notas      String?

  groupId    Int?
  group      Group?   @relation(fields: [groupId], references: [id])

  lembretes  lembretes[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model lembretes {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  data        DateTime @db.Date

  contactoId  Int
  contacto    Contacto @relation(fields: [contactoId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id         Int      @id @default(autoincrement())
  nome       String

  contactos  Contacto[]
}