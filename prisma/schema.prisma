generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  contactos Contacto[]
  groups    Group[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}


model Contacto {
  id         Int      @id @default(autoincrement())
  nome       String
  telefone   String
  email      String   @unique
  foto       String?
  notas      String?

  userId    String?     // colocar obrigatorio
  user      User?       @relation(fields: [userId], references: [id])     // colocar obrigatorio

  groupId    Int?      // colocar obrigatorio
  group      Group?   @relation(fields: [groupId], references: [id])     // colocar obrigatorio

  lembretes  lembretes[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model lembretes {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String? 
  data        DateTime @db.Date

  contactoId  Int
  contacto    Contacto @relation(fields: [contactoId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id         Int      @id @default(autoincrement())
  nome       String

 userId    String
  user      User       @relation(fields: [userId], references: [id])

  contactos  Contacto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}